# Production environment template — copy to `.env` at the repo root
#   cp .env.production.example .env
#   cd gitinventory-backend && php artisan key:generate --show

APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate

# Public URLs (TLS terminator / DNS)
APP_URL=https://app.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
# Leave empty when frontend nginx proxies /api to backend (recommended)
VITE_API_BASE_URL=
BILLING_CALLBACK_URL=https://app.yourdomain.com/settings?billing=success
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=app.yourdomain.com

# Published host ports
FRONTEND_PORT=80
BACKEND_PORT=8000

# TLS (docker-compose.tls.yml) — Caddy binds 80/443, so move SPA off 80:
# FRONTEND_PORT=8080
# DOMAIN=app.yourdomain.com
# ACME_EMAIL=admin@yourdomain.com
# APP_URL=https://app.yourdomain.com
# FRONTEND_URL=https://app.yourdomain.com
# BILLING_CALLBACK_URL=https://app.yourdomain.com/settings?billing=success

# Database (required)
DB_DATABASE=gitinventory
DB_USERNAME=gitinventory
DB_PASSWORD=change-me-strong-db-password

# Mail (SMTP example)
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=GITInventory

# Paystack — use LIVE keys in production
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
BILLING_CURRENCY=NGN
# Amounts in kobo
BILLING_STARTER_AMOUNT=1500000
BILLING_BUSINESS_AMOUNT=3500000
