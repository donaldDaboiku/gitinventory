# Staging environment — copy to `.env.staging` at the repo root
#   cp .env.staging.example .env.staging
#   cd gitinventory-backend && php artisan key:generate --show
#
# Run:
#   docker compose -f docker-compose.yml -f docker-compose.staging.yml --env-file .env.staging up --build -d

APP_ENV=staging
APP_DEBUG=false
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate

APP_URL=http://localhost:8001
FRONTEND_URL=http://localhost:8080
VITE_API_BASE_URL=
BILLING_CALLBACK_URL=http://localhost:8080/settings?billing=success
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:8080

FRONTEND_PORT=8080
BACKEND_PORT=8001

DB_DATABASE=gitinventory
DB_USERNAME=gitinventory
DB_PASSWORD=staging-db-password-change-me

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@staging.gitinventory.local
MAIL_FROM_NAME=GITInventory Staging

# Paystack TEST keys only (or leave empty for demo checkout)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
BILLING_CURRENCY=NGN
BILLING_STARTER_AMOUNT=1500000
BILLING_BUSINESS_AMOUNT=3500000
