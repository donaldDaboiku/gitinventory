APP_NAME="GITInventory"
APP_ENV=local
APP_KEY=base64:XeAbsNRPwUvAD9BYOAPL3rdz9eXB1rxfGzfnPxjpz4A=
APP_DEBUG=true
APP_URL=http://gitinventory.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel Herd uses PostgreSQL via its built-in services
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gitinventory
DB_USERNAME=root
DB_PASSWORD=Olaorbit@84

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Use database cache for local dev (switch to Redis in production)
CACHE_STORE=database

# Redis (Herd Pro includes Redis, or use Herd's database fallback)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@gitinventory.test"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum — allow both web and mobile
SANCTUM_STATEFUL_DOMAINS=gitinventory.test,localhost,127.0.0.1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paystack (Nigerian payments)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
